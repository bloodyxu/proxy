name: AI 相关规则覆盖
desc: 添加自定义 AI 相关规则到配置文件中（OpenAI 走新加坡节点，Claude 走美国节点）

# OpenAI 专属：自动测速 + 手动选择（候选为名称含新加坡/SG/🇸🇬 的节点）
proxy-groups:
  - name: OpenAI-Auto
    type: url-test
    hidden: true
    include-all: true
    filter: '🇸🇬|新加坡|[Ss]ingapore|\bSG\b'
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: OpenAI
    type: select
    proxies:
      - OpenAI-Auto
    include-all: true
    filter: '🇸🇬|新加坡|[Ss]ingapore|\bSG\b'
  # Claude 专属：自动测速 + 手动选择（候选为名称含美国/US/🇺🇸 的节点）
  - name: Claude-Auto
    type: url-test
    hidden: true
    include-all: true
    filter: '🇺🇸|美国|[Uu]nited [Ss]tates|\bUS\b'
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: Claude
    type: select
    proxies:
      - Claude-Auto
    include-all: true
    filter: '🇺🇸|美国|[Uu]nited [Ss]tates|\bUS\b'

rules:
  # 指定 IP 直连（优先级最高，放在规则最前）
  - IP-CIDR,201.18.220.240/32,DIRECT,no-resolve
  - DOMAIN-KEYWORD,notebooklm,AI
  - DOMAIN-KEYWORD,mixboard,AI
  - PROCESS-NAME,Cursor Helper,AI
  - PROCESS-NAME,Cursor Helper (Plugin),AI
  # Google Antigravity 客户端：IDE 主进程 + 各 Helper + 应用包内全部组件
  - PROCESS-NAME,Antigravity,AI
  - PROCESS-NAME,Antigravity Helper,AI
  - PROCESS-NAME,Antigravity Helper (GPU),AI
  - PROCESS-NAME,Antigravity Helper (Plugin),AI
  - PROCESS-NAME,Antigravity Helper (Renderer),AI
  - PROCESS-NAME,/Applications/Antigravity.app/,AI
  # Google Antigravity CLI / 语言服务：agy、antigravity、language_server*
  - PROCESS-NAME,agy,AI
  - PROCESS-NAME,antigravity,AI
  - PROCESS-NAME,language_server,AI
  - PROCESS-NAME,language_server_macos,AI
  - PROCESS-NAME,language_server_macos_arm,AI
  # Antigravity 相关域名兜底
  - DOMAIN-KEYWORD,antigravity,AI
  - DOMAIN-SUFFIX,cloudcode-pa.googleapis.com,AI
  - DOMAIN-SUFFIX,daily-cloudcode-pa.googleapis.com,AI
  - DOMAIN-KEYWORD,cursor.sh,AI
  - DOMAIN-KEYWORD,labs.google,AI
  - DOMAIN-KEYWORD,dia,AI
  - DOMAIN-KEYWORD,stitch,AI
  - DOMAIN-KEYWORD,jules.google.com,AI
  - DOMAIN-KEYWORD,notion,AI
  - DOMAIN-KEYWORD,google,AI
  - DOMAIN-KEYWORD,gemini.google.com,AI
  - DOMAIN-SUFFIX,muse.ai,AI
  - DOMAIN-SUFFIX,ai.meta.com,AI
  - DOMAIN-SUFFIX,developer.meta.com,AI
  # Claude / Anthropic：网页、API、Console、制品与 MCP 沙箱
  - DOMAIN-SUFFIX,anthropic.com,Claude
  - DOMAIN-SUFFIX,claude.ai,Claude
  - DOMAIN-SUFFIX,claude.com,Claude
  - DOMAIN-SUFFIX,claudeusercontent.com,Claude
  - DOMAIN-SUFFIX,clau.de,Claude
  - DOMAIN-SUFFIX,claudemcpcontent.com,Claude
  - DOMAIN-SUFFIX,claudemcpclient.com,Claude
  - DOMAIN,servd-anthropic-website.b-cdn.net,Claude
  # OpenAI / ChatGPT / Codex：桌面端、CLI、Computer Use，以及浏览器访问的官方域名
  - PROCESS-NAME,ChatGPT,OpenAI
  - PROCESS-NAME,Codex (Service),OpenAI
  - PROCESS-NAME,Codex (Renderer),OpenAI
  - PROCESS-NAME,codex,OpenAI
  - PROCESS-NAME,SkyComputerUseClient,OpenAI
  - PROCESS-NAME,SkyComputerUseService,OpenAI
  - PROCESS-NAME,/Applications/ChatGPT.app/,OpenAI
  - PROCESS-NAME,/.codex/,OpenAI
  - PROCESS-NAME,/Application Support/Codex/,OpenAI
  - PROCESS-NAME,/Application Support/OpenAI/,OpenAI
  - DOMAIN-SUFFIX,openai.com,OpenAI
  - DOMAIN-SUFFIX,chatgpt.com,OpenAI
  - DOMAIN-SUFFIX,oaistatic.com,OpenAI
  - DOMAIN-SUFFIX,oaiusercontent.com,OpenAI
  - DOMAIN-SUFFIX,openaiapi-site.azureedge.net,OpenAI
  - DOMAIN-SUFFIX,openaicom.imgix.net,OpenAI
  - DOMAIN-SUFFIX,openaicomproductionae4b.blob.core.windows.net,OpenAI
  - DOMAIN-SUFFIX,production-openaicom-storage.azureedge.net,OpenAI
  - DOMAIN-SUFFIX,chatgpt.livekit.cloud,OpenAI
  - DOMAIN-SUFFIX,chat.com,OpenAI
  - DOMAIN-SUFFIX,ai.com,OpenAI
  - DOMAIN-KEYWORD,openai,OpenAI
  - DOMAIN-KEYWORD,chatgpt,OpenAI
  - DOMAIN-KEYWORD,xiaohongshu,DIRECT
  - DOMAIN-KEYWORD,xhslink,DIRECT
  - DOMAIN-KEYWORD,xhscdn,DIRECT
  - DOMAIN-KEYWORD,qunar,DIRECT
